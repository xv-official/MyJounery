<!-- 合并到 android/app/src/main/AndroidManifest.xml 的 <manifest> 标签内，按需保留 -->
<uses-permission android:name="android.permission.INTERNET" />
<!-- Android 13+ 通知运行时权限（必须，否则 requestPermissions 无效） -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!-- Android 12+ 精确闹钟：保证杀掉 App 后到点仍能弹通知 -->
<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
<uses-permission android:name="android.permission.USE_EXACT_ALARM" />
<!-- 开机重启后：App 启动时由 JS 重新注册全部提醒 -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<!-- 引导用户把 App 加入电池优化白名单（国产 ROM 必做，非系统强制） -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
